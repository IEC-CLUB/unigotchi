rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Doodle Relay chains: anyone can read, start a chain, or add ONE entry at a time.
    match /chains/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['entries','done','updatedAt'])
                    && request.resource.data.entries is list
                    && request.resource.data.entries.size() <= 2
                    && request.resource.data.done == false;
      allow update: if request.resource.data.keys().hasOnly(['entries','done','updatedAt'])
                    && resource.data.done == false
                    && request.resource.data.entries.size() == resource.data.entries.size() + 1
                    && request.resource.data.entries.size() <= 8;
      allow delete: if false;
    }

    // F&L frames gallery: anyone can read and publish a small image; votes can only go up by 1.
    match /frames/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['img','spent','shape','votes','by','createdAt'])
                    && request.resource.data.img is string
                    && request.resource.data.img.size() < 150000
                    && request.resource.data.votes == 0;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                    && request.resource.data.votes == resource.data.votes + 1;
      allow delete: if false;
    }

    // HR Hangout lobby counters: anyone can read; each write adds exactly 1.
    match /hangout/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }
  }
}
